# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_YOUR_BOTFATHER_TOKEN
# The numeric Telegram user ID of the ONLY person allowed to use this bot.
# Get it by messaging @userinfobot on Telegram. Do NOT use a @username here.
TELEGRAM_OWNER_ID=000000000

# === Gmail ===
# Path to the OAuth client credentials JSON downloaded from Google Cloud Console
# (OAuth client type: Desktop app). Never commit this file.
GMAIL_CLIENT_SECRET_PATH=./data/client_secret.json
# Where the OAuth token (created by scripts/gmail_oauth_setup.py) is stored.
GMAIL_TOKEN_PATH=./data/gmail_token.json
# Where Gmail poll state (last_history_id) is persisted.
GMAIL_STATE_PATH=./data/gmail_state.json
GMAIL_POLL_INTERVAL_SECONDS=60

# === AI provider abstraction ===
# One of: openai | gemini | groq | local
AI_PROVIDER=gemini
# Model name understood by the selected provider.
AI_MODEL=gemini-1.5-flash
# Only the key matching AI_PROVIDER needs to be real.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Base URL for an OpenAI-compatible local server (e.g. Ollama), used when AI_PROVIDER=local
LOCAL_AI_BASE_URL=http://localhost:11434/v1

# === Storage (Phase 1 uses local SQLite; Phase 2 replaces with Postgres) ===
SQLITE_PATH=./data/email_agent.db

# === Phase 2+ (leave unset for Phase 1) ===
# DATABASE_URL=postgresql://user:pass@host:5432/email_agent
# RETENTION_DAYS=

# === Misc ===
LOG_LEVEL=INFO

# === Phase 4: Proactive Intelligence ===
DIGEST_HOUR_UTC=8
DEADLINE_REMINDER_WINDOW_HOURS=24
FOLLOWUP_DETECTION_DAYS=5
